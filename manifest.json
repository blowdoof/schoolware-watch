{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Schoolware Watch",
  "version": "0.5.0",
  "description": "Local observation history for Schoolware agenda changes.",
  "permissions": ["storage", "alarms", "activeTab"],
  "optional_permissions": ["notifications", "scripting", "webRequest"],
  "icons": { "128": "icons/icon128.png" },
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Schoolware Watch" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
